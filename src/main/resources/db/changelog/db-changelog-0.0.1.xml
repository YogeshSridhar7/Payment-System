<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd">

    <changeSet id="20170503041524-1" author="postgres" runOnChange="true" labels="0.0.1">
        <preConditions>
            <not>
                <and>
                    <columnExists tableName="PAYMENT_TABLE" columnName="Id"/>
                    <columnExists tableName="PAYMENT_TABLE" columnName="Order Number"/>
                    <columnExists tableName="PAYMENT_TABLE" columnName="Date"/>
                    <columnExists tableName="PAYMENT_TABLE" columnName="Total Amount"/>
                </and>
            </not>
        </preConditions>
        <createTable tableName="PAYMENT_TABLE">
            <column name="ID" type="NUMBER" >
                <constraints primaryKey="true" nullable="false" />
            </column>
            <column name="ORDER_NUMBER" type="NUMBER" >
                <constraints nullable="false" />
            </column>
            <column name="PAYMENT_DATE" type="TIMESTAMP">
                <constraints nullable="true" />
            </column>
            <column name="TOTAL_AMOUNT" type="NUMBER(30,2)">
                <constraints nullable="true" />
            </column>
        </createTable>
        <rollback>
            <dropTable tableName="PAYMENT_TABLE"/>
        </rollback>
    </changeSet>
</databaseChangeLog>